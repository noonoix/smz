<Window x:Class="ProMicroProvisioner.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Pro Micro Provisioner" Width="980" Height="720" MinWidth="820" MinHeight="620" FlowDirection="RightToLeft" Background="#292C33" Foreground="#F5F7FA" FontFamily="Segoe UI"><Window.Resources><Style TargetType="TextBox"><Setter Property="Background" Value="#333740"/><Setter Property="Foreground" Value="#F5F7FA"/><Setter Property="BorderBrush" Value="#444A55"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,0,10"/></Style><Style TargetType="ComboBox"><Setter Property="Background" Value="#333740"/><Setter Property="Foreground" Value="#111"/><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="0,4,0,10"/></Style><Style TargetType="Button"><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="14,6"/><Setter Property="Margin" Value="4"/></Style></Window.Resources><Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="420"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ScrollViewer Grid.Column="0"><StackPanel><TextBlock Text="آماده‌سازی Pro Micro" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="ATmega32U4 · 5V · 16MHz · نصب دومرحله‌ای با یک دکمه" Foreground="#B5BBC5" Margin="0,4,0,18"/><GroupBox Header="۱ — هویت آموزشی" Padding="12" Margin="0,0,0,12"><StackPanel><ComboBox x:Name="IdentityBox" DisplayMemberPath="Name" SelectionChanged="IdentityChanged"/><Button Content="تولید هویت تصادفی" Click="Random_Click" Background="#263A52" Foreground="White"/><TextBlock Text="سازنده"/><TextBox x:Name="ManufacturerBox"/><TextBlock Text="محصول"/><TextBox x:Name="ProductBox"/><UniformGrid Columns="3"><StackPanel><TextBlock Text="Boot VID"/><TextBox x:Name="VidBox"/></StackPanel><StackPanel><TextBlock Text="Boot PID"/><TextBox x:Name="BootPidBox"/></StackPanel><StackPanel><TextBlock Text="App PID"/><TextBox x:Name="AppPidBox"/></StackPanel></UniformGrid><TextBlock Text="پیشوند سریال"/><TextBox x:Name="SerialBox"/></StackPanel></GroupBox><GroupBox Header="۲ — فایل خصوصی و پروگرامر" Padding="12"><StackPanel><TextBlock Text="فایل ams_key.h را داخل پوشه PUT-KEY-HERE بینداز؛ برنامه آن را خودکار می‌خواند." Foreground="#72BC8F"/><DockPanel><Button Content="انتخاب کلید دیگر" Click="Key_Click"/><TextBox x:Name="KeyBox" IsReadOnly="True"/></DockPanel><DockPanel><Button Content="تشخیص واقعی ArduinoISP" Click="Detect_Click"/><ComboBox x:Name="PortBox" MinWidth="160"/></DockPanel></StackPanel></GroupBox><TextBlock Text="VID/PIDهای تولیدی فقط برای آزمایش خصوصی کلاس هستند." Foreground="#FFD27A" Margin="0,12"/><Button x:Name="InstallButton" Content="ساخت و نصب کامل" Click="Install_Click" Height="48" Background="#5E9FE8" Foreground="White" FontWeight="Bold"/></StackPanel></ScrollViewer><Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="وضعیت عملیات" FontSize="20" FontWeight="SemiBold"/><ProgressBar x:Name="Progress" Grid.Row="1" Height="12" Margin="0,12" Minimum="0" Maximum="100"/><TextBox x:Name="LogBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" FlowDirection="LeftToRight"/></Grid></Grid></Window>
