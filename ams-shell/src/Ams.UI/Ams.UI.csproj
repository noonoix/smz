<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\ams.ico</ApplicationIcon>
    <AssemblyName>ClassroomStudio</AssemblyName>
    <AssemblyTitle>Classroom Studio</AssemblyTitle>
    <Product>Classroom Studio</Product>
    <Description>Educational classroom workflow and input-automation studio</Description>
    <Version>0.9.67</Version>
    <RootNamespace>Ams.UI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="NAudio" Version="2.2.0" />
    <PackageReference Include="WPF-UI" Version="3.0.5" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup><Resource Include="Resources\ams.ico" /></ItemGroup>

  <ItemGroup>
    <None Include="..\..\bridge\**" Exclude="..\..\bridge\bridge.py;..\..\bridge\light_state_bridge.py"><Link>bridge\%(RecursiveDir)%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\bridge\bridge.py"><Link>bridge\_bridge_core.py</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\bridge\light_state_bridge.py"><Link>bridge\bridge.py</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\caterina\Caterina.hex"><Link>caterina\Caterina.hex</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\tools\isp_flash.py"><Link>tools\isp_flash.py</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\..\portable\plan3\CIRCUITPY\plan_cycle.py"><Link>portable-runtime\plan_cycle.py</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\..\portable\plan3\CIRCUITPY\plan_engine.py"><Link>portable-runtime\plan_engine.py</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\..\portable\plan3\CIRCUITPY\cycle_runtime.py"><Link>portable-runtime\cycle_runtime.py</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\..\portable\plan3\CIRCUITPY\restart_windows.py"><Link>portable-runtime\restart_windows.py</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\..\portable\plan3\CIRCUITPY\auto_resume_boot.py"><Link>portable-runtime\auto_resume_boot.py</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\..\portable\plan3\CIRCUITPY\resume_essentials_runtime.py"><Link>portable-runtime\resume_essentials_runtime.py</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\..\portable\plan3\autocycle_h6_patch.json"><Link>portable-runtime\autocycle_h6_patch.json</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\..\portable\plan3\CIRCUITPY\error_policy.py"><Link>portable-runtime\error_policy.py</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\..\portable\plan3\CIRCUITPY\live_light_guard.py"><Link>portable-runtime\live_light_guard.py</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\..\portable\plan3\CIRCUITPY\guard_transition.py"><Link>portable-runtime\guard_transition.py</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\..\portable\plan3\CIRCUITPY\guard_calibration_protocol.py"><Link>portable-runtime\guard_calibration_protocol.py</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\..\firmware\pico-light-guard-1.0.0\code.py"><Link>combined-runtime\code.py</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\..\firmware\pico-light-guard-1.0.0\boot.py"><Link>combined-runtime\boot.py</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\..\firmware\pico-light-guard-1.0.0\combined_guard_runtime.py"><Link>portable-runtime\combined_guard_runtime.py</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\..\firmware\pico-light-guard-1.0.0\combined_guard_runtime.py"><Link>combined-runtime\combined_guard_runtime.py</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\..\firmware\pico-light-guard-1.0.0\guard_calibration_protocol.py"><Link>combined-runtime\guard_calibration_protocol.py</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
  </ItemGroup>

  <Target Name="PatchPackagedCombinedGuardRuntime" AfterTargets="Build">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)\..\..\..\tools\patch_combined_runtime_output.py&quot; &quot;$(TargetDir)combined-runtime\code.py&quot;" />
  </Target>

</Project>
