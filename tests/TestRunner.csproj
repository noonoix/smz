<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ams-shell/src/Ams.UI/Ams.UI.csproj" />
  </ItemGroup>
  <!-- v0.9.67: keep the long-lived runner source compatible with the current Insert contract.
       playAudio remains registered for old .amsj files; buzzer is the visible Insert action. -->
  <Target Name="AlignLegacyRailContract" BeforeTargets="CoreCompile">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$p = Join-Path '$(MSBuildProjectDirectory)' 'TestRunner.cs'; $s = [IO.File]::ReadAllText($p); $old = '&quot;&quot;openFile&quot;&quot;, &quot;&quot;playAudio&quot;&quot;, &quot;&quot;runExe&quot;&quot;'; $new = '&quot;&quot;openFile&quot;&quot;, &quot;&quot;buzzer&quot;&quot;, &quot;&quot;runExe&quot;&quot;'; if (-not $s.Contains($old)) { throw 'legacy rail contract marker not found' }; [IO.File]::WriteAllText($p, $s.Replace($old, $new))&quot;" />
  </Target>
</Project>
