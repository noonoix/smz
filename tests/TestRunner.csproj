<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ams-shell/src/Ams.UI/Ams.UI.csproj" />
  </ItemGroup>
  <!-- v0.9.67: keep the long-lived runner source compatible with the current Insert contract.
       playAudio remains registered for old .amsj files; buzzer and Launch recovery are visible actions. -->
  <Target Name="AlignLegacyRailContract" BeforeTargets="CoreCompile">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$p = Join-Path '$(MSBuildProjectDirectory)' 'TestRunner.cs'; $s = [IO.File]::ReadAllText($p); $old = [char]34 + 'openFile' + [char]34 + ', ' + [char]34 + 'playAudio' + [char]34 + ', ' + [char]34 + 'runExe' + [char]34; $new = $old.Replace('playAudio','buzzer'); if (-not $s.Contains($old)) { throw 'legacy rail contract marker not found' }; $s = $s.Replace($old, $new); $countMarker = 'v43insert.Count == 24'; if (-not $s.Contains($countMarker)) { throw 'Launch recovery parity marker not found' }; $s = $s.Replace($countMarker, 'v43insert.Count == 25'); [IO.File]::WriteAllText($p, $s)&quot;" />
  </Target>
</Project>
